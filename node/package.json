{
  "name": "surense-sheet-sync",
  "version": "1.0.0",
  "description": "Mirrors Surense CRM leads into a spreadsheet, hourly, read-only against the CRM.",
  "type": "module",
  "bin": {
    "surense-sync": "./src/cli.js"
  },
  "scripts": {
    "sync": "node src/cli.js",
    "check": "node src/cli.js --check",
    "dry-run": "node src/cli.js --dry-run",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "exceljs": "^4.4.0",
    "googleapis": "^144.0.0"
  },
  "dependencies": {
    "pg": "^8.23.0"
  }
}
